generator client {
  provider = "prisma-client-js"
}

// Connection URLs live in prisma.config.js (Prisma 7) — não mais aqui.
datasource db {
  provider = "postgresql"
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  coverImageUrl  String?
  contentHtml    String     @db.Text
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  seoDescription String?
  author         StaffUser? @relation(fields: [authorId], references: [id])
  authorId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(ADMIN)
  posts        Post[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum StaffRole {
  ADMIN
  EDITOR
}

model TreatmentCategory {
  id         String      @id @default(cuid())
  label      String
  slug       String      @unique
  order      Int         @default(0)
  treatments Treatment[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([order])
}

model Treatment {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String            @db.Text
  imageUrl    String?
  imageAlt    String?
  order       Int               @default(0)
  category    TreatmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([categoryId, order])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model AboutContent {
  id           String   @id @default("about")
  kicker       String   @default("Sobre a")
  name         String   @default("Dra. Rebecca Amorim")
  intro        String   @db.Text
  paragraphs   String   @db.Text
  photoUrl     String?
  photoAlt     String?
  crm          String?
  rqe          String?
  instagramUrl String?
  lattesUrl    String?
  updatedAt    DateTime @updatedAt
}

model Credential {
  id        String   @id @default(cuid())
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ClinicAddress {
  id           String   @id @default(cuid())
  name         String
  neighborhood String
  city         String
  state        String
  address      String
  zip          String
  hours        String   @db.Text
  note         String?  @db.Text
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
}
