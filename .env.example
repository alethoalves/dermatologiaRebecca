# Postgres — Railway: copie a "Postgres Connection URL" do plugin Postgres do projeto.
DATABASE_URL="postgresql://user:password@host.railway.internal:5432/railway"

# Auth.js — gere com: npx auth secret (ou: openssl rand -base64 33)
AUTH_SECRET=""

# Armazenamento de imagens do blog: "local" (padrão, grava em public/uploads) ou "blob"
STORAGE_DRIVER="local"

# Usados apenas por prisma/seed.js para criar o primeiro StaffUser
SEED_ADMIN_NAME="Rebecca Amorim"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"
